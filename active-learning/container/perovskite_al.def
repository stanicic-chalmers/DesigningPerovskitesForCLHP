Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.10-py3

# Apptainer recipe for the environment of the paper runs.
# Python 3.12.3, PyTorch 2.9.0a0 (NVIDIA build nv25.10, CUDA 13.0) and NumPy 2.1.0 come with the base image;
# the other packages are pinned to the versions of the image used for the runs.
# Build:  apptainer build perovskite_al.sif perovskite_al.def     (may need --fakeroot)
# Run:    apptainer exec --nv perovskite_al.sif python -u active_learning_HEO.py ...

%post
    apt-get update && apt-get upgrade -y

    # LaTeX and fonts for mplpub figures; git and compilers for pip builds
    apt-get install -y --no-install-recommends \
        texlive-latex-base \
        texlive-fonts-recommended \
        texlive-latex-extra \
        dvipng \
        cm-super \
        fonts-dejavu-core \
        fontconfig \
        wget \
        git \
        build-essential

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --upgrade pip

    python3 -m pip install \
        gpytorch==1.15.2 \
        linear_operator==0.6.1 \
        flatten_dict==0.5.0 \
        emmet-core==0.87.2 \
        ase==3.29.0 \
        phonopy==4.7.2 \
        chgnet==0.4.2 \
        icet==4.0 \
        pymatgen==2026.9.24 \
        plotly==7.1.0 \
        psutil==7.1.0 \
        seaborn==0.13.2 \
        umap-learn==0.5.12 \
        pynndescent==0.6.0 \
        numba==0.62.1 \
        scikit-learn==1.7.2 \
        hdbscan==0.8.44 \
        pandas==3.0.6 \
        scipy==1.16.2 \
        matplotlib==3.10.7 \
        mplpub==1.1

%environment
    export PYTHONUNBUFFERED=1

%labels
    Description Environment for the active-learning design of perovskite oxygen carriers (DesigningPerovskitesForCLHP)
